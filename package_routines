pkg_pre_install(){
    # Backup config before upgrade (QPKG_CONFIG md5sum mechanism requires
    # a md5sum file we don't ship — do it manually instead)
    CONFIG_FILE="${SYS_QPKG_DIR}/config"
    CONFIG_BACKUP="/tmp/EmbyUpdater_config.bak"
    if [ -f "$CONFIG_FILE" ]; then
        cp -f "$CONFIG_FILE" "$CONFIG_BACKUP"
    fi
    return 0
}

pkg_install(){
    chmod +x "${SYS_QPKG_DIR}/emby-updater.sh"        2>/dev/null
    chmod +x "${SYS_QPKG_DIR}/EmbyUpdater.sh"          2>/dev/null
    chmod +x "${SYS_QPKG_DIR}/www/cgi-bin/api.cgi"     2>/dev/null
    chmod +x "${SYS_QPKG_DIR}/bin/busybox"             2>/dev/null
    return 0
}

pkg_post_install(){
    # Restore config if backup exists
    CONFIG_FILE="${SYS_QPKG_DIR}/config"
    CONFIG_BACKUP="/tmp/EmbyUpdater_config.bak"
    if [ -f "$CONFIG_BACKUP" ]; then
        cp -f "$CONFIG_BACKUP" "$CONFIG_FILE"
        rm -f "$CONFIG_BACKUP"
    fi

    /sbin/setcfg EmbyUpdater Enable TRUE -f /etc/config/qpkg.conf
    "${SYS_QPKG_DIR}/EmbyUpdater.sh" start 2>/dev/null
    return 0
}

pkg_pre_remove(){
    "${SYS_QPKG_DIR}/EmbyUpdater.sh" stop 2>/dev/null
    return 0
}

pkg_main_remove(){
    rm -f /var/run/EmbyUpdater.pid 2>/dev/null
    return 0
}

pkg_post_remove(){
    return 0
}
